# Шаблон змінних середовища для Croatia News Bot.
# Скопіюйте у файл .env (він у .gitignore) і заповніть значення. Сам .env НІКОЛИ не комітьте.
# У GitHub Actions ті самі назви задаються в Settings -> Environments (production / staging) -> Secrets.

# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Канал для публікацій: @username або числовий ID виду -100xxxxxxxxxx (бот має бути адміністратором)
TELEGRAM_CHANNEL_ID=-1001234567890

# (необов'язково) Чат для звітів після запуску та алертів ⚠️ ALARM
ADMIN_CHAT_ID=123456789

# Ключ Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# (необов'язково) Каскади моделей Gemini — назви через кому в порядку пріоритету.
# Якщо не задано — значення за замовчуванням з news_bot.py (DEFAULT_FILTER_MODELS / DEFAULT_TRANSLATE_MODELS).
# GEMINI_FILTER_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_TRANSLATE_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# (необов'язково) Тестовий запуск: пости — в ADMIN_CHAT_ID з позначкою ТЕСТ, файли стану не змінюються
# DRY_RUN=1
