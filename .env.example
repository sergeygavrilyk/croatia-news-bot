# Шаблон змінних середовища для Croatia News Bot.
# Скопіюйте у файл .env (він у .gitignore) і заповніть значення. Сам .env НІКОЛИ не комітьте.
# У GitHub Actions ті самі назви задаються в Settings -> Environments (production / staging) -> Secrets.

# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Канал для публікацій: @username або числовий ID виду -100xxxxxxxxxx (бот має бути адміністратором)
TELEGRAM_CHANNEL_ID=-1001234567890

# (необов'язково) Чат для звітів після запуску та алертів ⚠️ ALARM
ADMIN_CHAT_ID=123456789

# Ключ Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
